<?xml version="1.0" encoding="UTF-8"?>

<configuration>

    <appender name="CONSOLE"
              class="ch.qos.logback.core.ConsoleAppender">

        <encoder>
            <pattern>
                %d{HH:mm:ss.SSS}
                [%thread]
                %-5level
                %logger{50}
                - %msg%n
            </pattern>
        </encoder>

    </appender>


    <!-- Disable detailed application logs by default -->

    <root level="WARN">

        <appender-ref ref="CONSOLE"/>

    </root>


    <!-- Application layer -->

    <logger
            name="com.rgoncalo.financialapp.application"
            level="INFO"/>


    <!-- Persistence layer -->

    <logger
            name="com.rgoncalo.financialapp.infrastructure.persistence"
            level="DEBUG"/>


</configuration>