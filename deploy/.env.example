# Public HTTPS origin configured at the TLS terminator (Caddy, ALB, or CloudFront).
PUBLIC_ORIGIN=https://app.example.com

# This directory must live on persistent storage, such as an attached EBS volume.
DATA_DIRECTORY=/srv/financial-app/data

# The default only accepts connections from a TLS reverse proxy on this host.
# Use 0.0.0.0 only when an ALB security group limits inbound traffic.
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8080

# CI replaces this with an immutable commit-SHA tag when images are published.
IMAGE_TAG=local
