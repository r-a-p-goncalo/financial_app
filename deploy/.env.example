# Public HTTPS origin configured at the TLS terminator (Caddy, ALB, or CloudFront).
PUBLIC_ORIGIN=https://app.example.com

# Aurora PostgreSQL cluster writer endpoint. Keep Aurora private and use the
# current RDS CA bundle mounted below to verify the server certificate.
DATABASE_JDBC_URL=jdbc:postgresql://your-cluster.cluster-example.eu-west-1.rds.amazonaws.com:5432/financial_app?sslmode=verify-full&sslrootcert=/run/certificates/aws-rds-ca.pem
DATABASE_USERNAME=financial_app
DATABASE_PASSWORD=replace-with-a-secret-value
DATABASE_MAXIMUM_POOL_SIZE=10

# Download the current regional/global RDS CA bundle to this host. This path
# is mounted read-only at /run/certificates/aws-rds-ca.pem in the app container.
DATABASE_CA_CERTIFICATE_FILE=/srv/financial-app/certificates/aws-rds-ca.pem

# The default only accepts connections from a TLS reverse proxy on this host.
# Use 0.0.0.0 only when an ALB security group limits inbound traffic.
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8080

# CI replaces this with an immutable commit-SHA tag when images are published.
IMAGE_TAG=local
